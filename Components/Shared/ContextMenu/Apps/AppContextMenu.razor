@using BookHeaven.Reader.Features.AppDrawer.Abstractions
@using BookHeaven.Reader.Features.AppDrawer.Models
<ContextMenu>
	<ContextMenuItem IsDisabled="true">
		@App.Name
	</ContextMenuItem>
	<ContextMenuSeparator />
	@if(App.Shortcuts.Count > 0)
	{
		foreach(var shortcut in App.Shortcuts)
		{
			<ContextMenuItem OnClick="@(() => AppDrawerService.OpenAppShortcut(App.PackageName!, shortcut.Id!))">
				@if(shortcut.IconBase64 is not null)
				{
					<img src="data:image/png;base64,@shortcut.IconBase64" class="size-6" alt="@shortcut.ShortLabel" draggable="false"/>
				}
				<span>@shortcut.ShortLabel</span>
			</ContextMenuItem>
		}
		<ContextMenuSeparator />
	}
	<ContextMenuItem OnClick="@(() => AppDrawerService.OpenApp(App.PackageName!))">
		<svg  xmlns="http://www.w3.org/2000/svg"  width="24"  height="24"  viewBox="0 0 24 24"  fill="none"  stroke="currentColor"  stroke-width="1"  stroke-linecap="round"  stroke-linejoin="round"  class="icon icon-tabler icons-tabler-outline icon-tabler-external-link"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M12 6h-6a2 2 0 0 0 -2 2v10a2 2 0 0 0 2 2h10a2 2 0 0 0 2 -2v-6" /><path d="M11 13l9 -9" /><path d="M15 4h5v5" /></svg>
		<span>@Translations.OPEN</span>
	</ContextMenuItem>
	<ContextMenuItem OnClick="@(() => AppDrawerService.OpenInfo(App.PackageName!))">
		<svg  xmlns="http://www.w3.org/2000/svg"  width="24"  height="24"  viewBox="0 0 24 24"  fill="none"  stroke="currentColor"  stroke-width="1"  stroke-linecap="round"  stroke-linejoin="round"  class="icon icon-tabler icons-tabler-outline icon-tabler-info-circle"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M3 12a9 9 0 1 0 18 0a9 9 0 0 0 -18 0" /><path d="M12 9h.01" /><path d="M11 12h1v4h1" /></svg>
		@Translations.INFO
	</ContextMenuItem>
	@if(AppDrawerService.CanBeUninstalled(App.PackageName!))
	{
		<ContextMenuItem OnClick="@(() => AppDrawerService.UninstallApp(App.PackageName!))">
			<svg  xmlns="http://www.w3.org/2000/svg"  width="24"  height="24"  viewBox="0 0 24 24"  fill="none"  stroke="currentColor"  stroke-width="1"  stroke-linecap="round"  stroke-linejoin="round"  class="icon icon-tabler icons-tabler-outline icon-tabler-trash"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M4 7l16 0" /><path d="M10 11l0 6" /><path d="M14 11l0 6" /><path d="M5 7l1 12a2 2 0 0 0 2 2h8a2 2 0 0 0 2 -2l1 -12" /><path d="M9 7v-3a1 1 0 0 1 1 -1h4a1 1 0 0 1 1 1v3" /></svg>
			@Translations.UNINSTALL
		</ContextMenuItem>
	}
</ContextMenu>

@code {
	[Inject] private IAppDrawerService AppDrawerService { get; set; } = null!;
	
	[Parameter] public required AppInfo App { get; set; }
}