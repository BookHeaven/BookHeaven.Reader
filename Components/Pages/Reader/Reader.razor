@using System.Globalization
@using BookHeaven.Reader.Components.Pages.Reader.Partials
@attribute [Route($"{Urls.Reader}/{{id:guid}}")]
@layout EmptyLayout
<!--suppress CssUnresolvedCustomProperty -->
<style>
	:root {
		--info-bar-height: 24px;
	}
	
	body {
		margin: 0 !important;
		overflow: hidden;
	}

	@@scope (#viewer) {
		:scope {
			container-type: size;
			--column-count: 1;
			--chapter-page: @ReaderService.State?.PageNumber;
			--font-size: @ReaderService.Settings?.FontSize.ToString("0.00", CultureInfo.InvariantCulture);
			--line-height: @ReaderService.Settings?.LineHeight.ToString("0.00", CultureInfo.InvariantCulture);
			--letter-spacing: @ReaderService.Settings?.LetterSpacing.ToString("0.00", CultureInfo.InvariantCulture);
			--paragraph-spacing: @ReaderService.Settings?.ParagraphSpacing.ToString("0.00", CultureInfo.InvariantCulture);
			--text-indent: @ReaderService.Settings?.TextIndent.ToString("0.00", CultureInfo.InvariantCulture);
			--word-spacing: @ReaderService.Settings?.WordSpacing.ToString("0.00", CultureInfo.InvariantCulture);
			--margin-vertical: @ReaderService.Settings?.VerticalMargin.ToString("0.00", CultureInfo.InvariantCulture);
			--margin-horizontal: @ReaderService.Settings?.HorizontalMargin.ToString("0.00", CultureInfo.InvariantCulture);
			--page-gap: 6;
			--page-height: 100cqh;
			--page-width: 100cqw;
			
			@@media (min-width: 800px) and (orientation: landscape) {
				--column-count: 2;
				--page-gap: calc(var(--margin-horizontal) * 2);
				--page-width: calc((100cqw - (var(--page-gap) * 1rem)) / 2);
			}
			
			margin: calc(var(--margin-vertical) * 1rem) calc(var(--margin-horizontal) * 1rem);
			

			& > .chapter {
				height: var(--page-height);
				column-width: var(--page-width);
				font-size: calc(var(--font-size) * 1px) !important;
				letter-spacing: calc(var(--letter-spacing) * 1px);
				column-fill: auto;
				column-gap: calc(var(--page-gap) * 1px);
				padding: 0;
				orphans: 1;
				widows: 1;


				&.current {
					transform: translateX(
						calc(
							(var(--page-width) + (var(--page-gap) * 1px)) 
							* (var(--chapter-page) - 1)
							* var(--column-count)
							* -1
						)
					);
				}

				& p {
					word-break: auto-phrase !important;
					hyphens: none !important;
				}
			}
		}

		img, svg, figure {
			box-sizing: border-box;
			object-fit: contain !important;
			break-inside: avoid !important;
			max-width: 100%;
			max-height: var(--page-height) !important;
			float: none !important;
		}

		@($":scope > .chapter p:not([class]){(!string.IsNullOrEmpty(ReaderService.State?.CurrentChapter?.ParagraphClassName) ? $",:scope > .chapter.current .{ReaderService.State.CurrentChapter.ParagraphClassName}" : "")}") {
			margin-block: calc(var(--paragraph-spacing) * 1pt) !important;
		}

		:scope sup {
			font-size: 0.6em;
			line-height: normal;
			font-weight: bold;
		}

		:scope .drop-cap {
			orphans: 2;
			display: flow-root;
			&::first-letter {
				initial-letter: 2;
				margin-inline-end: 0.3em;
			}

			& + p {
				clear: both;
			}
		}
	}
	@@scope(#viewer .current) {
		@if (ReaderService.State?.Styles.Count > 0)
		{
			foreach (var style in ReaderService.State.Styles.Where(style => ReaderService.State.CurrentChapter?.Stylesheets.Any(s => s.Contains(style.Identifier)) == true))
			{
				@style.Content
			}
		}
	}
</style>
@if (_book is not null)
{
	<StandbyWallpaper ImageSrc="@_book.CoverUrl()" />
}
<ColorTemperatureOverlay />
<FontManager />
<ImageViewer />
<Navigation />
@if (!ReaderService.IsReady)
{
	<Message Content="@Translations.LOADING_BOOK"/>
}
<Overlay
	Progress="@(ReaderService.State?.ProgressAsPercentage ?? 0)"
	BookTitle="@_book?.Title"
	ChapterTitle="@ReaderService.State?.ChapterTitle"
	IsTocEmpty="ReaderService.State?.Ebook?.Content.TableOfContents.Count == 0"/>

<TableOfContents
	Chapters="@ReaderService.State?.Ebook?.Content.TableOfContents"
	CurrentChapterId="@ReaderService.State?.CurrentChapter?.Identifier"/>


<div class="flex h-screen flex-col @(!ReaderService.IsReady ? "invisible" : "")">
	<div id="viewer" class="flex-1 overflow-hidden">
		<div class="chapter current">
			@if (ReaderService.State?.CurrentChapter?.IsContentProcessed == true)
			{
				@((MarkupString)ReaderService.State.CurrentChapter.Content)
			}
		</div>
		@*<div class="chapter current">
			@if (ReaderService.State?.CurrentChapter?.IsContentProcessed == true)
			{
				@((MarkupString)ReaderService.State.CurrentChapter.Content)
			}
		</div>
		<div class="chapter prev invisible">
			@if (ReaderService.State?.PreviousChapter?.IsContentProcessed == true)
			{
				@((MarkupString)ReaderService.State.PreviousChapter.Content)
			}
		</div>
		<div class="chapter next invisible">
			@if (ReaderService.State?.NextChapter?.IsContentProcessed == true)
			{
				@((MarkupString)ReaderService.State.NextChapter.Content)
			}
		</div>*@
		@foreach (var chapter in ReaderService.State?.Ebook?.Content.Chapters ?? [])
		{
			<div class="chapter invisible">
				@if (chapter.IsContentProcessed)
				{
					@((MarkupString)chapter.Content)
				}
			</div>
		}
	</div>

	<div class="relative mx-2 mt-auto flex h-(--info-bar-height) gap-2">
		@if (ReaderService.IsReady)
		{
			<Clock/>
			<BatteryInfo/>
			<ChapterTitle />
			<div class="ms-auto text-end">
				@(ReaderService.State?.ProgressAsPercentage.ToString("0.00"))%
			</div>
		}
	</div>
</div>