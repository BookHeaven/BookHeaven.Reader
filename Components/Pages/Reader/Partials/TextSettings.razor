@using BookHeaven.Core.Features.Fonts
@using BookHeaven.Core.Features.Reader.Abstractions
<div class="settings border-t-2 border-solid border-black bg-white" @onclick:stopPropagation="true">
    <label class="my-auto ms-3 text-nowrap">@Translations.FONT</label>
    <select @bind="@ReaderSettingsService.ReaderSettings!.SelectedFont" @bind:after="() => ReaderSettingsService.NotifySettingChanged(nameof(ReaderSettingsService.ReaderSettings.SelectedFont))" class="mx-4 my-2">
        <option value="">@Translations.DEFAULT</option>
        @foreach (var font in _fonts)
        {
            <option value="@font.Family">@font.Family</option>
        }
    </select>
    <RangeSlider Label="@Translations.FONT_SIZE" Min="10" Max="32" @bind-Value="@ReaderSettingsService.ReaderSettings.FontSize" @bind-Value:after="() => ReaderSettingsService.NotifySettingChanged()"/>
    <RangeSlider Label="@Translations.LETTER_SPACING" Min="0" Max="2" Increment="0.1m" @bind-Value="ReaderSettingsService.ReaderSettings.LetterSpacing" @bind-Value:after="() => ReaderSettingsService.NotifySettingChanged()" />
    @* <TextSetting Label="Word Spacing" Min="0" Max="5" Increment="0.25" @bind-Value="ReaderService.ProfileSettings.WordSpacing" /> *@
    <RangeSlider Label="@Translations.LINE_HEIGHT" Min="1.2m" Max="2.5m" Increment="0.05m" @bind-Value="ReaderSettingsService.ReaderSettings.LineHeight" @bind-Value:after="() => ReaderSettingsService.NotifySettingChanged()"/>
    <RangeSlider Label="@Translations.TEXT_INDENT" Min="0" Max="3" Increment="0.5m" @bind-Value="ReaderSettingsService.ReaderSettings.TextIndent" @bind-Value:after="() => ReaderSettingsService.NotifySettingChanged()"/>
    <RangeSlider Label="@Translations.PARAGRAPH_SPACING" Min="0" Max="20" Increment="2" @bind-Value="ReaderSettingsService.ReaderSettings.ParagraphSpacing" @bind-Value:after="() => ReaderSettingsService.NotifySettingChanged()"/>
</div>

@code {
    [Inject] private IReaderSettingsService ReaderSettingsService { get; set; } = null!;
    [Inject] private ISender Sender { get; set; } = null!;

    readonly List<Font> _fonts = [];
    
    protected override async Task OnInitializedAsync()
    {
        var getVariants = await Sender.Send(new GetAllFonts.Query());
        if (getVariants.IsSuccess)
        {
            _fonts.AddRange(getVariants.Value.GroupBy(v => v.Family).Select(v => v.First()));
        }
    }
}