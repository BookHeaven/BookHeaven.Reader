@implements IDisposable
<div>
    @_clock
</div>

@code {
    string _clock = DateTime.Now.ToString("HH:mm");
    PeriodicTimer? _clockTimer;
    CancellationTokenSource? _timerCts;

    protected override async Task OnInitializedAsync()
    {
        var now = DateTime.Now;
        var msToNextMinute = (60 - now.Second) * 1000 - now.Millisecond;
        if (msToNextMinute <= 0) msToNextMinute = 1000;
        await Task.Delay(msToNextMinute);
        _clock = DateTime.Now.ToString("HH:mm");
        StateHasChanged();

        
        _ = RunTimerAsync();
    }

    private async Task RunTimerAsync()
    {
        _timerCts = new CancellationTokenSource();
        _clockTimer = new PeriodicTimer(TimeSpan.FromMinutes(1));

        try
        {
            while (await _clockTimer.WaitForNextTickAsync(_timerCts.Token))
            {
                await InvokeAsync(() =>
                {
                    _clock = DateTime.Now.ToString("HH:mm");
                    StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException) { }
        catch (ObjectDisposedException) { }
    }

    public void Dispose()
    {
        _timerCts?.Cancel();
        _timerCts?.Dispose();
        _clockTimer?.Dispose();
        GC.SuppressFinalize(this);
    }
}