@implements IDisposable
<div>
    @_clock
</div>

@code {
    string _clock = DateTime.Now.ToString("HH:mm");
    IDispatcherTimer? _clockTimer;

    protected override async Task OnInitializedAsync()
    {
        var now = DateTime.Now;
        var msToNextMinute = (60 - now.Second) * 1000 - now.Millisecond;
        if (msToNextMinute <= 0) msToNextMinute = 1000;
        await Task.Delay(msToNextMinute);
        _clock = DateTime.Now.ToString("HH:mm");
        StateHasChanged(); 
        RunTimer();
    }

    private void RunTimer()
    {
        _clockTimer = Application.Current?.Dispatcher.CreateTimer();
        
        if(_clockTimer is null) return;
        
        _clockTimer.Interval = TimeSpan.FromMinutes(1);
        _clockTimer.Tick += (s, e) =>
        {
            InvokeAsync(() =>
            {
                _clock = DateTime.Now.ToString("HH:mm");
                StateHasChanged();
            });
        };
        _clockTimer.Start();
    }

    public void Dispose()
    {
        _clockTimer?.Stop();
        GC.SuppressFinalize(this);
    }
}