@using System.Timers
@implements IDisposable
<div>
    @_clock
</div>

@code {
    string _clock = DateTime.Now.ToString("HH:mm");
    readonly Timer _clockTimer = new() { Interval = TimeSpan.FromSeconds(1).TotalMilliseconds };

    protected override void OnInitialized()
    {
        _clockTimer.Elapsed += (_, _) =>
        {
            var time = DateTime.Now.ToString("HH:mm");
            if (time == _clock) return;

            _clock = time;
            InvokeAsync(StateHasChanged);
        };
        _clockTimer.Start();
    }

    public void Dispose()
    {
        _clockTimer.Dispose();
        GC.SuppressFinalize(this);
    }
}