@using BookHeaven.Core.Features.Reader.Abstractions
@using BookHeaven.Reader.Functions
@implements IAsyncDisposable
<div class="absolute w-screen h-screen z-999 grid grid-cols-3" @oncontextmenu="@OpenImageViewer" @oncontextmenu:preventDefault @oncontextmenu:stopPropagation>
    @foreach(var button in Buttons)
    {
        <span @onclick="@(() => HandleNavigation(button))"></span>
    }
</div>

@code {
    [Inject] private OverlayService OverlayService { get; set; } = null!;
    [Inject] private IReaderService ReaderService { get; set; } = null!;
    [Inject] private IReaderSettingsService ReaderSettingsService { get; set; } = null!;
    [Inject] private IJSRuntime JsRuntime { get; set; } = null!;
    [Inject] private ImageViewerService ImageViewerService { get; set; } = null!;

    private NavigationLayoutType _selectedLayout;
    
    private IJSObjectReference _module = null!;
    
    private List<NavigationButton> Buttons => ReaderFunctions.GetLayoutForType(_selectedLayout);
    
    protected override void OnInitialized()
    {
        _selectedLayout = (NavigationLayoutType)ReaderSettingsService.ReaderSettings!.SelectedLayout;
        ReaderSettingsService.OnSettingsChanged += OnSelectedLayoutChanged;
    }
    
    private void OnSelectedLayoutChanged()
    {
        if(ReaderSettingsService.ReaderSettings?.SelectedLayout == (int)_selectedLayout) return;
        _selectedLayout = (NavigationLayoutType)ReaderSettingsService.ReaderSettings!.SelectedLayout;
        InvokeAsync(StateHasChanged);
    }
    
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _module = await JsRuntime.InvokeAsync<IJSObjectReference>("import", "./Components/Pages/Reader/Partials/Navigation.razor.js");
        }
    }

    private void HandleNavigation(NavigationButton button)
    {
        switch (button)
        {
            case NavigationButton.None:
                break;
            case NavigationButton.Next:
                ReaderService.NextPage();
                break;
            case NavigationButton.Previous:
                ReaderService.PreviousPage();
                break;
            case NavigationButton.Overlay:
                OverlayService.ToggleOverlay();
                break;
        }
    }

    private async Task OpenImageViewer(MouseEventArgs e)
    {
        var data = await _module.InvokeAsync<string?>("FindZoomableElement", e.ClientX, e.ClientY);
        if (!string.IsNullOrEmpty(data))
        {
            ImageViewerService.OnOpenImage?.Invoke(data);
        }
    }

    public async ValueTask DisposeAsync()
    {
        ReaderSettingsService.OnSettingsChanged -= OnSelectedLayoutChanged;
        await _module.DisposeAsync();
    }
}