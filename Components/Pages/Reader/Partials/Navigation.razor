@using BookHeaven.Core.Features.Reader.Abstractions
@using BookHeaven.Reader.Features.Reader
@using BookHeaven.Reader.Features.Reader.Enums
@using BookHeaven.Reader.Features.Reader.Helpers
@using BookHeaven.Reader.Features.Reader.Services
@implements IAsyncDisposable
<div class="pointer-events-none absolute z-999 h-screen w-screen" aria-hidden="true"></div>

@code {
    [Inject] private OverlayService OverlayService { get; set; } = null!;
    [Inject] private IReaderService ReaderService { get; set; } = null!;
    [Inject] private IReaderSettingsService ReaderSettingsService { get; set; } = null!;
    [Inject] private IJSRuntime JsRuntime { get; set; } = null!;
    [Inject] private ImageViewerService ImageViewerService { get; set; } = null!;

    private NavigationLayoutType _selectedLayout;
    
    private IJSObjectReference? _module;
    private DotNetObjectReference<Navigation> _dotNetReference = null!;
    
    private List<NavigationButton> Buttons => ReaderHelpers.GetLayoutForType(_selectedLayout);
    
    protected override void OnInitialized()
    {
        ReaderSettingsService.OnSettingChanged += OnSelectedLayoutChanged;
    }
    
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_module is not null || ReaderSettingsService.ReaderSettings is not { } settings) return;

        try
        {
            _selectedLayout = (NavigationLayoutType)settings.SelectedLayout;
            _module = await JsRuntime.InvokeAsync<IJSObjectReference>("import", "./Components/Pages/Reader/Partials/Navigation.razor.js");
            _dotNetReference = DotNetObjectReference.Create(this);
            await _module.InvokeVoidAsync("Initialize", _dotNetReference, Buttons.Select(button => (int)button).ToArray());
        }
        catch
        {
            throw new Exception("Error initializing Navigation component");
        }
        
    }
    
    private async void OnSelectedLayoutChanged(string? settingName)
    {
        if (!string.IsNullOrEmpty(settingName) &&
            settingName != nameof(ReaderSettingsService.ReaderSettings.SelectedLayout)) return;
        if (ReaderSettingsService.ReaderSettings is not { } settings) return;

        _selectedLayout = (NavigationLayoutType)settings.SelectedLayout;
        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("UpdateLayout", Buttons.Select(button => (int)button).ToArray());
            }
            catch
            {
                throw new Exception("Error updating Navigation layout");
            }
            
        }
        await InvokeAsync(StateHasChanged);
    }

    [JSInvokable("OnNavigationTap")]
    public void OnNavigationTap(int index)
    {
        if (index >= 0 && index < Buttons.Count)
            HandleNavigation(Buttons[index]);
    }

    [JSInvokable("OnKeyDown")]
    public void OnKeyDown(string key)
    {
        if (OverlayService.IsOverlayVisible) return;

        switch (key)
        {
            case "PageDown":
                HandleNavigation(NavigationButton.Next);
                break;
            case "PageUp":
                HandleNavigation(NavigationButton.Previous);
                break;
        }
    }

    [JSInvokable("OnOpenImageViewer")]
    public void OnOpenImageViewerFromJs(string? data)
    {
        if (!string.IsNullOrEmpty(data))
            ImageViewerService.OnOpenImage?.Invoke(data);
    }
    
    

    private void HandleNavigation(NavigationButton button)
    {
        switch (button)
        {
            case NavigationButton.None:
                break;
            case NavigationButton.Next:
                ReaderService.NextPage();
                break;
            case NavigationButton.Previous:
                ReaderService.PreviousPage();
                break;
            case NavigationButton.Overlay:
                OverlayService.ToggleOverlay();
                break;
        }
    }

    public async ValueTask DisposeAsync()
    {
        ReaderSettingsService.OnSettingChanged -= OnSelectedLayoutChanged;
        try
        {
            if (_module is not null)
            {
                await _module.InvokeVoidAsync("Dispose");
                await _module.DisposeAsync();
            }

            _dotNetReference?.Dispose();
        }
        catch
        {
            // Ignore exceptions during disposal
        }
        
    }
}