@using BookHeaven.Core.Features.Reader.Abstractions
@using Microsoft.JSInterop
@implements IDisposable

<div @ref="_containerRef" class="flex items-center justify-center">
    <span @ref="_textRef" class="text-nowrap">@DisplayText</span>
    <span @ref="_pageRef" class="ms-1 text-nowrap">
        (@ReaderService.State?.PageNumber / @(ReaderService.IsCalculatingPages ? "..." : ReaderService.State?.TotalPages))
    </span>
</div>

@code {
    [Inject] private IJSRuntime JsRuntime { get; set; } = null!;
    [Inject] private IReaderService ReaderService { get; set; } = null!;

    private ElementReference _containerRef;
    private ElementReference _textRef;
    private ElementReference _pageRef;
    private IJSObjectReference? _module;
    private DotNetObjectReference<ChapterTitle>? _callbackRef;
    private string DisplayText { get; set; } = string.Empty;

    private string _currentTitle = string.Empty;
    private decimal _currentAvailableWidth;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _module = await JsRuntime.InvokeAsync<IJSObjectReference>("import", "./Components/Pages/Reader/Partials/ChapterTitle.razor.js");
            _callbackRef = DotNetObjectReference.Create(this);
            await _module.InvokeVoidAsync("observeResize", _containerRef, _callbackRef);
            ReaderService.OnPageChanged += RefreshUi;
            ReaderService.OnChapterChanged += UpdateTitle;
            ReaderService.OnTotalPagesChanged += RefreshUi;
            await ProcessTitle();
        }
    }

    private void UpdateTitle()
    {
        _ = ProcessTitle();
    }

    [JSInvokable]
    public void OnResize()
    {
        _ = ProcessTitle();
    }

    private async Task ProcessTitle()
    {
        if (_module is null) return;

        var title = ReaderService.State?.ChapterTitle ?? string.Empty;
        var m = await _module.InvokeAsync<TitleMeasurement>("measureTitle", _containerRef, _textRef, _pageRef, title);

        if (m.AvailableWidth == _currentAvailableWidth && _currentTitle == title) return;
        _currentTitle = title;
        _currentAvailableWidth = m.AvailableWidth;

        if (m.FullTextWidth <= m.AvailableWidth)
        {
            DisplayText = title;
        }
        else
        {
            var avgCharWidth = m.FullTextWidth / (title.Length == 0 ? 1 : title.Length);
            var maxChars = Math.Max(4, (int)(m.AvailableWidth / avgCharWidth));
            var half = (maxChars - 1) / 2;
            DisplayText = title[..half] + "…" + title[^half..];
        }

        await InvokeAsync(StateHasChanged);
    }

    private void RefreshUi()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        ReaderService.OnPageChanged -= RefreshUi;
        ReaderService.OnChapterChanged -= UpdateTitle;
        ReaderService.OnTotalPagesChanged -= RefreshUi;
        _callbackRef?.Dispose();
        _module?.InvokeVoidAsync("dispose");
        _module?.DisposeAsync();
    }

    private sealed record TitleMeasurement(decimal AvailableWidth, decimal FullTextWidth);

}