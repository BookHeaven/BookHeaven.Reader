@using BookHeaven.Core.Abstractions.Services
@using BookHeaven.Core.Features.Fonts
@using BookHeaven.Core.Features.Reader.Abstractions
@implements IDisposable
@if(_fonts.Count == 0) return;
<style>
	@foreach (var font in _fonts)
	{
		@font.GetFontFace(UrlBuilder.FontUrl(font.Family, font.FileName));
	}
	@@scope (#viewer) {
		:scope {
			font-family: '@ReaderSettingsService.ReaderSettings?.SelectedFont', serif;
		}
	}
</style>
@code {
	[Inject] private IReaderSettingsService ReaderSettingsService { get; set; } = null!;
	[Inject] private ISender Sender { get; set; } = null!;
	[Inject] private AppStateService AppStateService { get; set; } = null!;
	[Inject] private IUrlBuilder UrlBuilder { get; set; } = null!;
	
	List<Font> _fonts = [];
	string? _fontFamily = string.Empty;

	protected override async Task OnInitializedAsync()
	{
		ReaderSettingsService.OnSettingChanged += OnSelectedFontChanged;
		await GetFonts();
	}
	
	private async Task GetFonts()
	{
		_fontFamily = ReaderSettingsService.ReaderSettings?.SelectedFont;
		var getFonts = await Sender.Send(new GetAllFonts.Query(_fontFamily));
		if (getFonts.IsFailure)
		{
			return;
		}

		_fonts = getFonts.Value;
	}
	
	private async void OnSelectedFontChanged(string? settingName)
	{
		if(!string.IsNullOrEmpty(settingName)) return;
		if(settingName != nameof(ReaderSettingsService.ReaderSettings.SelectedFont)) return;

		await GetFonts();
		await InvokeAsync(StateHasChanged);
	}

	public void Dispose()
	{
		ReaderSettingsService.OnSettingChanged -= OnSelectedFontChanged;
	}

}