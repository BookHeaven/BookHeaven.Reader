@using BookHeaven.Core.Features.Fonts
@using BookHeaven.Core.Features.Reader.Abstractions
@implements IDisposable
@if(_fonts.Count == 0) return;
@foreach(var variant in _fonts)
{
	<link rel="preload" href="@variant.Url()" as="font" crossorigin="anonymous"/>
}
<style>
	@foreach (var font in _fonts)
	{
		@font.GetFontFace()
	}
	@@scope (#viewer) {
		:scope {
			font-family: '@ReaderSettingsService.ReaderSettings?.SelectedFont', serif;
		}
	}
</style>
@code {
	[Inject] IReaderSettingsService ReaderSettingsService { get; set; } = null!;
	[Inject] ISender Sender { get; set; } = null!;
	[Inject] AppStateService AppStateService { get; set; } = null!;
	
	List<Font> _fonts = [];
	string? _fontFamily = string.Empty;

	protected override async Task OnInitializedAsync()
	{
		ReaderSettingsService.OnSettingsChanged += OnSelectedFontChanged;
		await GetFonts();
	}
	
	private async Task GetFonts()
	{
		_fontFamily = ReaderSettingsService.ReaderSettings?.SelectedFont;
		var getFonts = await Sender.Send(new GetAllFonts.Query(_fontFamily));
		if (getFonts.IsFailure)
		{
			return;
		}

		_fonts = getFonts.Value;
	}
	
	private async void OnSelectedFontChanged()
	{
		var newFontFamily = ReaderSettingsService.ReaderSettings?.SelectedFont;
		if (newFontFamily == _fontFamily) return;

		await GetFonts();
		await InvokeAsync(StateHasChanged);
	}

	public void Dispose()
	{
		ReaderSettingsService.OnSettingsChanged -= OnSelectedFontChanged;
	}

}