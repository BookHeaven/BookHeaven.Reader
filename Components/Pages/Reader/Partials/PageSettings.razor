@using BookHeaven.Core.Features.Reader.Abstractions
<div class="settings border-solid border-t-2 border-black bg-white" @onclick:stopPropagation="true">
    <NavigationSettings/>
    <RangeSlider Label="@Translations.VERTICAL_MARGIN" Min="0" Max="10" Increment="0.5m" @bind-Value="ReaderSettingsService.ReaderSettings!.VerticalMargin" @bind-Value:after="() => ReaderSettingsService.NotifySettingsChanged()" />
    <RangeSlider Label="@Translations.HORIZONTAL_MARGIN" Min="0" Max="10" Increment="0.5m" @bind-Value="ReaderSettingsService.ReaderSettings!.HorizontalMargin" @bind-Value:after="() => ReaderSettingsService.NotifySettingsChanged()"  />
    <RangeSlider Label="@Translations.PAGE_GAP" Min="0" Max="500" Increment="10" @bind-Value="ReaderSettingsService.ReaderSettings!.PageGap" @bind-Value:after="() => ReaderSettingsService.NotifySettingsChanged()"/>
</div>

@code {
    [Inject] private IReaderSettingsService ReaderSettingsService { get; set; } = null!;
}