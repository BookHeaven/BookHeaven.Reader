@using BookHeaven.Core.Features.Reader.Abstractions
<div class="settings border-black bg-white border-t-2 border-solid" @onclick:stopPropagation="true">
    <NavigationSettings/>
    <RangeSlider Label="@Translations.VERTICAL_MARGIN" Min="0" Max="10" Increment="0.5m" @bind-Value="ReaderSettingsService.ReaderSettings!.VerticalMargin" @bind-Value:after="() => ReaderSettingsService.NotifySettingChanged()" />
    <RangeSlider Label="@Translations.HORIZONTAL_MARGIN" Min="0" Max="10" Increment="0.5m" @bind-Value="ReaderSettingsService.ReaderSettings!.HorizontalMargin" @bind-Value:after="() => ReaderSettingsService.NotifySettingChanged()"  />
</div>

@code {
    [Inject] private IReaderSettingsService ReaderSettingsService { get; set; } = null!;
}