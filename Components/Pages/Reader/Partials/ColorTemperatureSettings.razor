@using BookHeaven.Reader.Features.Preferences.Services
@using BookHeaven.Reader.Features.Reader.Helpers
<div class="border-black bg-white p-5 border-t-2 border-solid" @onclick:stopPropagation="true">
	<CheckBox Label="Enable color temperature adjustment" @bind-Checked="PreferencesService.EnableColorTemperatureAdjustment"/>
	<p class="italic">This is only useful for non e-ink displays</p>
	@if (PreferencesService.EnableColorTemperatureAdjustment)
	{
		<div class="my-3 flex items-center justify-center">
			@foreach (var temp in TemperaturesInKelvin)
			{
				<span 
					@onclick="() => { if(PreferencesService.ColorTemperatureInKelvin != temp) PreferencesService.ColorTemperatureInKelvin = temp; }"
					class="size-12 @(temp == PreferencesService.ColorTemperatureInKelvin ? "border-black border" : "")" 
					style="background-color: @ReaderFunctions.KelvinToRgb(temp,1)"></span>
			}
		</div>
		<RangeSlider 
			Label="Opacity"
			Min="0.1m"
			Max="1"
			Increment="0.1m"
			@bind-Value="PreferencesService.ColorTemperatureOpacity"/>
	}
</div>

@code {
	[Inject] private PreferencesService PreferencesService { get; set; } = null!;
	
	private int[] TemperaturesInKelvin { get; } = [2000, 2500, 3000, 4000, 5000, 6500, 8000, 10000];
}