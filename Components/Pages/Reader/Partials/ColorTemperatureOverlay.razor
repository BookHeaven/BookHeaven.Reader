@using BookHeaven.Reader.Features.Preferences.Services
@using BookHeaven.Reader.Functions
@implements IDisposable

@if(!PreferencesService.EnableColorTemperatureAdjustment) return;
<div class="inset-0 pointer-events-none fixed z-99999999 mix-blend-multiply" style="background-color: @ReaderFunctions.KelvinToRgb(PreferencesService.ColorTemperatureInKelvin, (double)PreferencesService.ColorTemperatureOpacity);"></div>

@code {
	[Inject] private PreferencesService PreferencesService { get; set; } = null!;
	
	protected override void OnInitialized()
	{
		PreferencesService.OnTemperatureSettingsChanged += Refresh;
	}
	
	private void Refresh() => InvokeAsync(StateHasChanged);

	public void Dispose()
	{
		PreferencesService.OnTemperatureSettingsChanged -= Refresh;
	}
}