@using BookHeaven.EbookManager.Entities
@using BookHeaven.Reader.Features.Reader.Services
@implements IDisposable
@if (!OverlayService.IsTocVisible)
{   
    return;
}
<CascadingValue Value="CurrentChapterId">
    <div @onclick="OverlayService.ToggleToc" class="top-0 left-0 right-0 bottom-0 absolute z-[1000]">
        <div id="spine" @onclick:stopPropagation="true" @onclick:preventDefault="true" class="border-black bg-white z-[1001] h-full w-[70%] overflow-y-auto border-r-2 border-solid">
            <div class="ms-2 pt-2 font-bold text-center">@Translations.INDEX</div>
            @foreach (var chapter in Chapters ?? [])
            {
                <TableOfContentsEntry Entry="@chapter" />
            }
        </div>
    </div>
</CascadingValue>


@code {
    [Inject] OverlayService OverlayService { get; set; } = null!;
    
    [Parameter] public IReadOnlyList<TocEntry>? Chapters { get; set; }
    [Parameter] public string? CurrentChapterId { get; set; }

    protected override void OnInitialized()
    {
        OverlayService.OnOverlayChanged += RefreshUi;
    }
    
    public void Dispose()
    {
        OverlayService.OnOverlayChanged -= RefreshUi;
    }
    
    private void RefreshUi()
    {
        InvokeAsync(StateHasChanged);
    }
}