@using BookHeaven.Core.Abstractions
@using BookHeaven.Core.Features.Profiles
@using BookHeaven.Reader.Features.Preferences.Services
@attribute [Route(Urls.Profiles)]
@layout EmptyLayout
@if (!_initialized)
{
	<Message Content="@Translations.LOADING"/>
	return;
}

<div class="flex h-screen w-screen flex-col items-center justify-center">
	<h2>Select your profile</h2>
	<div class="mt-3 gap-2 flex flex-wrap items-center justify-center">
		@foreach (var profile in _profiles)
		{
			<Button Class="size-20 p-0! border-black text-sm rounded-lg border-2" OnClick="() => SetProfile(profile.ProfileId)">
				@profile.Name
			</Button>
		}
	</div>
</div>

@code {
	[Inject] private ISender Sender { get; set; } = null!;
	[Inject] private PreferencesService PreferencesService { get; set; } = null!;
	[Inject] private NavigationManager NavigationManager { get; set; } = null!;
	[Inject] private IAlertService AlertService { get; set; } = null!;

	private bool _initialized;
	private List<Profile> _profiles = [];

	protected override async Task OnInitializedAsync()
	{
		var getProfiles = await Sender.Send(new GetAllProfiles.Query());
		if (!getProfiles.IsSuccess)
		{
			await AlertService.ShowToastAsync(getProfiles.Error.Description);
			return;
		}
		_profiles = getProfiles.Value;
		_initialized = true;
	}
	
	private void SetProfile(Guid profileId)
	{
		PreferencesService.ProfileId = profileId;
		NavigationManager.NavigateTo(Urls.Books);
	}
}