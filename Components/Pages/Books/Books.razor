@attribute [Route(Urls.Books)]
@using BookHeaven.Core.Abstractions
@using BookHeaven.Core.Enums
@using BookHeaven.Core.Services
@using BookHeaven.Reader.Components.Dialogs.Books
@using BookHeaven.Reader.Components.Pages.Books.Components
@layout BooksLayout
@implements IDisposable
@if (!_initialized)
{
    <Message Content="Loading your library..." />
    return;
}

@if(BookManager.IsEmpty)
{
    <Message Content="@Translations.NO_BOOKS_FOUND" OnButtonClick="@(() => NavigationManager.NavigateTo("/books/remote"))">
        <ButtonContent>
            <svg  xmlns="http://www.w3.org/2000/svg"  width="24"  height="24"  viewBox="0 0 24 24"  fill="none"  stroke="currentColor"  stroke-width="2"  stroke-linecap="round"  stroke-linejoin="round"  class="icon icon-tabler icons-tabler-outline icon-tabler-book-download"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M12 20h-6a2 2 0 0 1 -2 -2v-12a2 2 0 0 1 2 -2h12v5" /><path d="M13 16h-7a2 2 0 0 0 -2 2" /><path d="M15 19l3 3l3 -3" /><path d="M18 22v-9" /></svg>
            @Translations.DOWNLOAD_BOOKS
        </ButtonContent>
    </Message>
    return;
}

<BookInfoDialog />

<SectionContent SectionName="Filters">
    <div class="m-2 flex items-center">
        @if (string.IsNullOrEmpty(_filter))
        {
            <RadioButtonGroup @bind-SelectedOption="_currentTab">
                <RadioButton Option="Tab.Home">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-home">
                        <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                        <path d="M5 12l-2 0l9 -9l9 9l-2 0" />
                        <path d="M5 12v7a2 2 0 0 0 2 2h10a2 2 0 0 0 2 -2v-7" />
                        <path d="M9 21v-6a2 2 0 0 1 2 -2h2a2 2 0 0 1 2 2v6" />
                    </svg>
                </RadioButton>
                <RadioButton Option="Tab.Shelf" Label="@Translations.SHELF" Count="BookManager.Books.Count" />
            </RadioButtonGroup>
        }
        <div class="ms-auto">
            <SearchBar @bind-Filter="_filter" />
        </div>
    </div>
    @*@if(_currentTab == Tab.Shelf)
    {
        <div class="flex items-center justify-between">
            <Button>
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-adjustments-horizontal">
                    <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                    <path d="M12 6a2 2 0 1 0 4 0a2 2 0 1 0 -4 0" />
                    <path d="M4 6l8 0" />
                    <path d="M16 6l4 0" />
                    <path d="M6 12a2 2 0 1 0 4 0a2 2 0 1 0 -4 0" />
                    <path d="M4 12l2 0" />
                    <path d="M10 12l10 0" />
                    <path d="M15 18a2 2 0 1 0 4 0a2 2 0 1 0 -4 0" />
                    <path d="M4 18l11 0" />
                    <path d="M19 18l1 0" />
                </svg>
            </Button>
            <Button>
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-filter-2">
                    <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                    <path d="M4 6h16" />
                    <path d="M6 12h12" />
                    <path d="M9 18h6" />
                </svg>
            </Button>
        </div>
    }*@
</SectionContent>

@if (string.IsNullOrEmpty(_filter))
{
    switch (_currentTab)
    {
        case Tab.Home:
            <div class="flex h-full flex-col">
                <div class="flex-1">
                    <BookSection 
                        SectionName="@BookStatus.Reading.StringValue()"
                        Books="BookManager.Books"
                        FilterByStatus="@BookStatus.Reading"
                        OrderBy="books => books.OrderByDescending(b => b.Progress().LastRead)"/>
                </div>
                <hr class="mx-4 my-2 border-t-neutral-300 border-t-2" />
                <div class="flex-1">
                    <BookSection 
                        SectionName="@BookStatus.New.StringValue()"
                        Books="BookManager.Books"
                        FilterByStatus="@BookStatus.New"
                        HideBadges="true"/>
                </div>
            </div>
            break;
        case Tab.Shelf:
            <BooksGrid Books="BookManager.Books" />
            break;
    }
}
else
{
    <BooksGrid Books="FilteredBooks" />
}

@code {
    [Inject] private IAlertService AlertService { get; set; } = null!;
    [Inject] private NavigationManager NavigationManager { get; set; } = null!;
    [Inject] private PreferencesService PreferencesService { get; set; } = null!;
    [Inject] private BookManager BookManager { get; set; } = null!;
    [Inject] private ISender Sender { get; set; } = null!;

    private bool _initialized;
    private Tab _currentTab = Tab.Home;

    private IEnumerable<Book> FilteredBooks => 
        string.IsNullOrEmpty(_filter) 
            ? BookManager.Books 
            : BookManager.Books.Where(b => 
                b.Title?.Contains(_filter, StringComparison.OrdinalIgnoreCase) == true
                || b.Author?.Name?.Contains(_filter, StringComparison.OrdinalIgnoreCase) == true
                || b.Series?.Name?.Contains(_filter, StringComparison.OrdinalIgnoreCase) == true);
    
    private string _filter = string.Empty;

    protected override void OnInitialized()
    {
        if (PreferencesService.ProfileId == Guid.Empty) return;

        BookManager.OnBooksChanged += RefreshUi;
        _ = LoadBooksAsync();
    }

    private async Task LoadBooksAsync()
    {
        await BookManager.GetBooksAsync(PreferencesService.ProfileId);
        _initialized = true;
        await InvokeAsync(StateHasChanged);
    }

    private void RefreshUi()
    {
        InvokeAsync(StateHasChanged);
    }
    
    public void Dispose()
    {
        BookManager.OnBooksChanged -= RefreshUi;
    }

    private enum Tab
    {
        Home,
        Shelf
    }
}