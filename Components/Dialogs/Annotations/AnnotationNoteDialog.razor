<div class="inset-0 bg-black/50 fixed z-[1002] grid place-items-center" @onclick="CancelAsync">
    <section class="rounded-lg bg-white p-4 shadow-xl w-[min(32rem,calc(100vw-2rem))]"
        @onclick:stopPropagation="true">
        <h2 class="mb-3 text-lg font-semibold">@Annotation.ChapterTitle</h2>
        <p class="mb-3 bg-neutral-200 p-2 text-sm line-clamp-3">
            &ldquo;@Annotation.Text&rdquo;
        </p>
        <textarea class="min-h-36 rounded border-neutral-400 p-2 w-full resize-y border"
            @bind="_noteDraft" autofocus></textarea>
        <div class="mt-3 gap-2 flex justify-end">
            <Button OnClick="CancelAsync">@Translations.CANCEL</Button>
            <Button OnClick="SaveAsync">@Translations.SAVE</Button>
        </div>
    </section>
</div>

@code {
    [Parameter] public BookAnnotation Annotation { get; set; } = null!;
    
    [Parameter] public EventCallback<BookAnnotation> OnSave { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private string _noteDraft = string.Empty;

    protected override void OnInitialized()
    {
        _noteDraft = Annotation.Note ?? string.Empty;
    }

    private Task SaveAsync()
    {
        Annotation.Note = _noteDraft;
        return OnSave.InvokeAsync(Annotation);
    }

    private Task CancelAsync() => OnCancel.InvokeAsync();
}
