<div class="inset-0 bg-black/50 fixed z-[1002] grid place-items-center" @onclick="CancelAsync">
    <section class="rounded-lg bg-white border-black w-[min(32rem,calc(100vw-2rem))] border-2"
        @onclick:stopPropagation="true">
        <header class="my-3 mx-4 flex items-center justify-between">
            <h2 class="text-lg font-semibold m-0">@Translations.NOTE</h2>
            <Button Class="p-0!" OnClick="@CancelAsync">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-x size-8"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M18 6l-12 12"/><path d="M6 6l12 12"/></svg>
            </Button>
        </header>
        
        <p class="mb-3 bg-neutral-200 p-2 mx-4 text-sm line-clamp-3">
            &ldquo;@Annotation.Text&rdquo;
        </p>
        <hr class="border-neutral-300"/>
        <textarea class="h-36 p-5 w-full resize-none scrollbar-gutter-both border-none outline-none"
            @bind="_noteDraft" autofocus></textarea>
        <hr class="border-neutral-300"/>
        <div class="gap-2 p-4 flex justify-end">
            <Button OnClick="@CancelAsync">@Translations.CANCEL</Button>
            <Button OnClick="@SaveAsync">@Translations.SAVE</Button>
        </div>
    </section>
</div>

@code {
    [Parameter] public BookAnnotation Annotation { get; set; } = null!;
    
    [Parameter] public EventCallback<BookAnnotation> OnSave { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private string _noteDraft = string.Empty;

    protected override void OnInitialized()
    {
        _noteDraft = Annotation.Note ?? string.Empty;
    }

    private Task SaveAsync()
    {
        Annotation.Note = _noteDraft;
        return OnSave.InvokeAsync(Annotation);
    }

    private Task CancelAsync() => OnCancel.InvokeAsync();
}
