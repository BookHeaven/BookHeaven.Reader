<div class="inset-0 bg-black/50 fixed z-[1002] grid place-items-center" @onclick="CancelAsync">
    <section class="rounded-lg bg-white p-4 shadow-xl w-[min(32rem,calc(100vw-2rem))]"
        @onclick:stopPropagation="true">
        <h2 class="mb-3 text-lg font-semibold">@Title</h2>
        <p class="mb-3 bg-neutral-200 p-2 text-sm line-clamp-3">
            &ldquo;@PassageText&rdquo;
        </p>
        <textarea class="min-h-36 rounded border-neutral-400 p-2 w-full resize-y border"
            @bind="_noteDraft" autofocus></textarea>
        <div class="mt-3 gap-2 flex justify-end">
            <button class="rounded px-3 py-2 active:bg-neutral-100" @onclick="CancelAsync">@Translations.CANCEL</button>
            <button class="rounded bg-neutral-800 px-3 py-2 text-white active:bg-neutral-700" @onclick="SaveAsync">@Translations.SAVE</button>
        </div>
    </section>
</div>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string PassageText { get; set; } = string.Empty;
    [Parameter] public string? InitialNote { get; set; }
    [Parameter] public EventCallback<string> OnSave { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private string _noteDraft = string.Empty;

    protected override void OnInitialized()
    {
        _noteDraft = InitialNote ?? string.Empty;
    }

    private Task SaveAsync() => OnSave.InvokeAsync(_noteDraft);

    private Task CancelAsync() => OnCancel.InvokeAsync();
}
